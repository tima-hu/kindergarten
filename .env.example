# Скопируйте в .env и заполните. Файл .env никому не показывайте.
SECRET_KEY=замените-на-длинную-случайную-строку
DEBUG=False
# Домены и/или IP сервера через запятую
ALLOWED_HOSTS=example.com,www.example.com
# Адреса сайта с http:// или https:// через запятую (нужно для входа в админку)
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# Поставьте True после подключения HTTPS (включает защищённые cookie и редирект на https)
HTTPS=False
